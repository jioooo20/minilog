  "incidents": [
    {
      "incident_id": 1,
      "incident_code": "INC-20250315-001",
      "title": "Mesin PRESS-01 berhenti mendadak",
      "description": "Saat proses stamping, mesin berhenti dengan error code E-421. Tekanan hidrolik turun drastis dari 120 bar ke 45 bar.",
      "item_id": 1,
      "component_item_id": 4,
      "location_id": 5,
      "severity": "High",
      "status": "closed",
      "detected_at": "2025-03-15T08:05:00",
      "investigating_started_at": "2025-03-15T08:15:00",
      "repair_started_at": "2025-03-15T09:45:00",
      "resolved_at": "2025-03-15T10:20:00",
      "closed_at": "2025-03-15T10:35:00",
      "reported_by": 1,
      "handled_by": 2,
      "closed_by": 3,
      "approved_by": 3,
      "verified_by": 1,
      "root_cause_hypothesis": "Diduga sensor tekanan mengalami drift karena belum dikalibrasi selama 6 bulan. Pembacaan menjadi tidak akurat sehingga PLC mengira tekanan terlalu rendah.",
      "investigation_notes": "Cek log PLC: pembacaan tekanan fluktuatif tidak normal. Cek fisik sensor: tidak ada kerusakan mekanik. Terakhir kalibrasi September 2024.",
      "hypothesis_approved": true,
      "hypothesis_review_notes": "Setuju. Data log mendukung hipotesis. Silakan lanjut kalibrasi.",
      "hypothesis_approved_at": "2025-03-15T09:40:00",
      "corrective_actions": "Melakukan kalibrasi sensor tekanan menggunakan pressure calibrator. Mengatur ulang threshold alarm di PLC dari 100 bar menjadi 110 bar.",
      "parts_replaced": null,
      "verification_notes": "Mesin dijalankan selama 30 menit dengan 3 siklus produksi, semua parameter normal. Produk stamping sesuai spesifikasi.",
      "verified_at": "2025-03-15T10:25:00",
      "closing_notes": "Insiden selesai. Disarankan jadwal kalibrasi sensor tekanan setiap 3 bulan ke depan."
    },
    {
      "incident_id": 2,
      "incident_code": "INC-20250316-002",
      "title": "Welding robot arm error pada axis 3",
      "description": "Robot berhenti dengan alarm 'Servo overload axis 3' saat melakukan welding cycle.",
      "item_id": 2,
      "component_item_id": null,
      "location_id": 6,
      "severity": "Medium",
      "status": "closed",
      "detected_at": "2025-03-16T13:20:00",
      "investigating_started_at": "2025-03-16T13:30:00",
      "repair_started_at": "2025-03-16T14:00:00",
      "resolved_at": "2025-03-16T14:45:00",
      "closed_at": "2025-03-16T15:00:00",
      "reported_by": 4,
      "handled_by": 5,
      "closed_by": 3,
      "approved_by": 3,
      "verified_by": 4,
      "root_cause_hypothesis": "Grease pada gearbox axis 3 sudah mengering, menyebabkan gesekan berlebih.",
      "investigation_notes": "Cek grease level: kering. Tidak ada kebocoran, kemungkinan belum pernah dilakukan regrease sejak instalasi.",
      "hypothesis_approved": true,
      "hypothesis_review_notes": "Setuju. Segera lakukan regrease dan monitor.",
      "hypothesis_approved_at": "2025-03-16T13:55:00",
      "corrective_actions": "Melakukan regrease gearbox axis 3 dengan grease lithium EP2. Melakukan home positioning ulang.",
      "parts_replaced": null,
      "verification_notes": "Robot dijalankan 10 siklus welding, tidak ada alarm. Gerakan axis 3 halus.",
      "verified_at": "2025-03-16T14:50:00",
      "closing_notes": "Insiden selesai. Tambahkan jadwal regrease setiap 6 bulan untuk semua axis."
    },
